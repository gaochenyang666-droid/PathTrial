{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathtrial.dev/schemas/diagnose-1.0.0.json",
  "title": "PathTrial guided diagnosis",
  "description": "Scenario-oriented diagnosis with user-facing checks, possible causes, unproven causes and next checks. Every check evidence reference is prefixed with its source report name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "run_id",
    "scenario",
    "target",
    "started_at",
    "finished_at",
    "status",
    "checks",
    "sources",
    "limitations",
    "redaction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "tool_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "enum": [
        "web",
        "vps",
        "latency",
        "proxy",
        "local",
        "dns",
        "tcp",
        "tls",
        "http",
        "dual-stack",
        "udp-quic"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "ips_masked"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "ips_masked": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "SKIP",
        "INCONCLUSIVE"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "summary",
        "evidence",
        "observed",
        "possible",
        "not_established",
        "next_checks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+:[A-Za-z0-9_.-]+$"
          }
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "possible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_established": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "report"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "type": "object"
        }
      }
    }
  }
}
