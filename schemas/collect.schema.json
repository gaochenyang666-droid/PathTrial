{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathtrial.dev/schemas/collect-1.0.0.json",
  "title": "PathTrial collect report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "kind",
    "task_id",
    "role",
    "protocol",
    "target",
    "listen",
    "window",
    "clock",
    "resolved_addresses",
    "events",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "kind": {
      "const": "collect"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "client",
        "server"
      ]
    },
    "protocol": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "listen": {
      "type": [
        "string",
        "null"
      ]
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "synchronized",
        "note"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "synchronized": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "resolved_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "at",
          "kind",
          "sequence",
          "task_id_seen",
          "duration_ms",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string"
          },
          "peer": {
            "type": [
              "string",
              "null"
            ]
          },
          "local": {
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "task_id_seen": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
